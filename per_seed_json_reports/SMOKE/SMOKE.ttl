ex:SMOKE-P01 a ifcowl:IfcProcedure ;
    ifcowl:identification "SMOKE-P01" ;
    ifcowl:name "抢险救援" ;
    ifcowl:objectType "RescueProcess" ;
    ifcowl:predefinedType "USERDEFINED" ;
    hep:completionRate "0.0"^^xsd:float ;
    hep:dataProvenance "derived|SPEC_001|process_engine/templates" ;
    hep:hasTask ex:SMOKE-T01,
        ex:SMOKE-T02,
        ex:SMOKE-T03 ;
    hep:priority 0 ;
    hep:processStatus "NOT_STARTED" ;
    hep:processType "RESCUE" ;
    hep:provenanceLevel "derived" ;
    hep:replanningCount 0 ;
    hep:sourceId "SPEC_001" ;
    hep:triggerEventId "EVT-SMOKE-001" .

