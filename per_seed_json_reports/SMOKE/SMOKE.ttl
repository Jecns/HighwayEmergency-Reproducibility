@prefix ex: <https://w3id.org/hepn/instances/> .
@prefix hep: <https://w3id.org/hepn/> .
@prefix ifcowl: <https://standards.buildingsmart.org/IFC/DEV/IFC4X3/ADD2/OWL/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

hep:ExtremeWeatherEvent a owl:Class ;
    rdfs:label "ExtremeWeatherEvent" ;
    rdfs:comment "极端天气事件 — 附件1类别: 恶劣天气" ;
    rdfs:subClassOf hep:HighwayEmergencyEvent .

hep:GeologicalDisasterEvent a owl:Class ;
    rdfs:label "GeologicalDisasterEvent" ;
    rdfs:comment "地质灾害事件 — 附件1类别: 公路水运工程基础设施" ;
    rdfs:subClassOf hep:HighwayEmergencyEvent .

hep:HazardousChemicalLeakEvent a owl:Class ;
    rdfs:label "HazardousChemicalLeakEvent" ;
    rdfs:comment "危化品泄漏事件 — 附件1类别: 危险化学(品)运输车辆事故" ;
    rdfs:subClassOf hep:HighwayEmergencyEvent .

hep:InfrastructureFailureEvent a owl:Class ;
    rdfs:label "InfrastructureFailureEvent" ;
    rdfs:comment "基础设施失效事件 — 附件1类别: 公路水运工程基础设施" ;
    rdfs:subClassOf hep:HighwayEmergencyEvent .

hep:actualResourceQuantity a owl:DatatypeProperty ;
    rdfs:label "actualResourceQuantity" ;
    rdfs:domain ifcowl:IfcTask ;
    rdfs:range xsd:integer .

hep:assignedToTask a owl:ObjectProperty ;
    rdfs:label "assignedToTask" ;
    rdfs:domain ifcowl:IfcCrewResource ;
    rdfs:range ifcowl:IfcTask .

hep:blockageStatus a owl:DatatypeProperty ;
    rdfs:label "blockageStatus" ;
    rdfs:domain ifcowl:IfcEvent ;
    rdfs:range xsd:string .

hep:capacity a owl:DatatypeProperty ;
    rdfs:label "capacity" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:float .

hep:casualtyCount a owl:DatatypeProperty ;
    rdfs:label "casualtyCount" ;
    rdfs:domain ifcowl:IfcEvent ;
    rdfs:range xsd:integer .

hep:completionRate a owl:DatatypeProperty ;
    rdfs:label "completionRate" ;
    rdfs:domain ifcowl:IfcProcedure ;
    rdfs:range xsd:float .

hep:confidence a owl:DatatypeProperty ;
    rdfs:label "confidence" ;
    rdfs:domain ifcowl:IfcEvent ;
    rdfs:range xsd:float .

hep:dataProvenance a owl:DatatypeProperty ;
    rdfs:label "dataProvenance" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

hep:eventType a owl:DatatypeProperty ;
    rdfs:label "eventType" ;
    rdfs:domain ifcowl:IfcEvent ;
    rdfs:range xsd:string .

hep:expectedDurationHours a owl:DatatypeProperty ;
    rdfs:label "expectedDurationHours" ;
    rdfs:domain ifcowl:IfcTask ;
    rdfs:range xsd:float .

hep:hasIncidentType a owl:ObjectProperty ;
    rdfs:label "hasIncidentType" ;
    rdfs:domain ifcowl:IfcEvent ;
    rdfs:range ifcowl:IfcEvent,
        hep:HighwayEmergencyEvent .

hep:hasTask a owl:ObjectProperty ;
    rdfs:label "hasTask" ;
    rdfs:domain ifcowl:IfcProcedure ;
    rdfs:range ifcowl:IfcTask .

ex:EVT-SMOKE-001 a ifcowl:IfcEvent ;
    ifcowl:identification "EVT-SMOKE-001" ;
    ifcowl:name "追尾事故（演示）" ;
    ifcowl:objectType "HighwayEmergencyEvent" ;
    ifcowl:predefinedType "STARTEVENT" ;
    hep:blockageStatus "OPEN" ;
    hep:casualtyCount 0 ;
    hep:confidence "1.0"^^xsd:float ;
    hep:dataProvenance "derived|SYNTH_SCENARIO_GEN|run_experiments#smoke" ;
    hep:eventType "TRAFFIC_ACCIDENT" ;
    hep:hasIncidentType hep:TrafficAccidentEvent ;
    hep:locationReference "G3011-K350+600" ;
    hep:provenanceLevel "derived" ;
    hep:secondaryHazard false ;
    hep:severityLevel "III" ;
    hep:sourceId "SYNTH_SCENARIO_GEN" ;
    hep:startTime "2026-09-08T14:05:00" ;
    hep:triggersProcess ex:SMOKE-P01 ;
    hep:vehicleCount 0 .

